<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-add-request-state-change-table" author="lukasz.ciecwierz">
        <createTable tableName="request_state_change">
            <column name="id" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="request_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="state_from" type="varchar(30)"/>
            <column name="state_to" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="request_state_change"
                baseColumnNames="request_id"
                constraintName="fk_request_state_change_request"
                referencedTableName="request"
                referencedColumnNames="id"
        />

        <createIndex tableName="request_state_change" indexName="idx_request_state_change_request_id">
            <column name="request_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
